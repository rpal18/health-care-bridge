        {
          "name": "login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Visualization Script",
                  "// Visualization Script",
                  "",
                  "const template = `",
                  "<html>",
                  "<head>",
                  "  <style>",
                  "    body {",
                  "      font-family: 'Segoe UI', Arial, sans-serif;",
                  "      background: #f4f6f9;",
                  "      margin: 0;",
                  "      padding: 20px;",
                  "    }",
                  "    h2 {",
                  "      color: #2c3e50;",
                  "      margin-bottom: 16px;",
                  "      font-size: 18px;",
                  "      border-bottom: 2px solid #3498db;",
                  "      padding-bottom: 8px;",
                  "    }",
                  "    table {",
                  "      width: 100%;",
                  "      border-collapse: collapse;",
                  "      background: #ffffff;",
                  "      border-radius: 8px;",
                  "      overflow: hidden;",
                  "      box-shadow: 0 2px 8px rgba(0,0,0,0.08);",
                  "    }",
                  "    th {",
                  "      background-color: #3498db;",
                  "      color: #ffffff;",
                  "      text-align: left;",
                  "      padding: 10px 16px;",
                  "      font-size: 13px;",
                  "      text-transform: uppercase;",
                  "      letter-spacing: 0.5px;",
                  "    }",
                  "    td {",
                  "      padding: 10px 16px;",
                  "      font-size: 13px;",
                  "      color: #34495e;",
                  "      border-bottom: 1px solid #ecf0f1;",
                  "      vertical-align: top;",
                  "      word-break: break-word;",
                  "    }",
                  "    tr:nth-child(even) td {",
                  "      background-color: #f8fafc;",
                  "    }",
                  "    tr:last-child td {",
                  "      border-bottom: none;",
                  "    }",
                  "    .key-cell {",
                  "      font-weight: 600;",
                  "      color: #2c3e50;",
                  "      width: 30%;",
                  "      white-space: nowrap;",
                  "    }",
                  "    .sub-table {",
                  "      width: 100%;",
                  "      border-collapse: collapse;",
                  "      margin-top: 4px;",
                  "    }",
                  "    .sub-table td {",
                  "      padding: 4px 8px;",
                  "      font-size: 12px;",
                  "      border-bottom: 1px solid #ecf0f1;",
                  "      background: transparent;",
                  "    }",
                  "    .sub-table td:first-child {",
                  "      font-weight: 600;",
                  "      color: #7f8c8d;",
                  "      width: 40%;",
                  "    }",
                  "    .badge {",
                  "      display: inline-block;",
                  "      background: #eaf4fb;",
                  "      color: #2980b9;",
                  "      border-radius: 4px;",
                  "      padding: 2px 8px;",
                  "      font-size: 12px;",
                  "    }",
                  "    .no-data {",
                  "      color: #aaa;",
                  "      font-style: italic;",
                  "    }",
                  "  </style>",
                  "</head>",
                  "<body>",
                  "  <h2>Login as Admin — Response</h2>",
                  "  <table>",
                  "    <thead>",
                  "      <tr>",
                  "        <th>Field</th>",
                  "        <th>Value</th>",
                  "      </tr>",
                  "    </thead>",
                  "    <tbody>",
                  "      {{#each rows}}",
                  "      <tr>",
                  "        <td class=\"key-cell\">{{key}}</td>",
                  "        <td>",
                  "          {{#if isObject}}",
                  "            <table class=\"sub-table\">",
                  "              {{#each subRows}}",
                  "              <tr>",
                  "                <td>{{subKey}}</td>",
                  "                <td>{{subVal}}</td>",
                  "              </tr>",
                  "              {{/each}}",
                  "            </table>",
                  "          {{else}}",
                  "            <span class=\"badge\">{{value}}</span>",
                  "          {{/if}}",
                  "        </td>",
                  "      </tr>",
                  "      {{/each}}",
                  "    </tbody>",
                  "  </table>",
                  "</body>",
                  "</html>",
                  "`;",
                  "",
                  "function formatValue(val) {",
                  "  if (val === null || val === undefined) return 'N/A';",
                  "  if (typeof val === 'boolean') return val ? 'true' : 'false';",
                  "  return String(val);",
                  "}",
                  "",
                  "function createPayload() {",
                  "  var data = pm.response.json();",
                  "  var rows = [];",
                  "",
                  "  var skipKeys = [];",
                  "",
                  "  Object.keys(data).forEach(function(key) {",
                  "    var val = data[key];",
                  "",
                  "    // Skip null values",
                  "    if (val === null || val === undefined) return;",
                  "",
                  "    // Skip empty arrays",
                  "    if (Array.isArray(val) && val.length === 0) return;",
                  "",
                  "    // Handle nested objects (non-array)",
                  "    if (typeof val === 'object' && !Array.isArray(val)) {",
                  "      var subRows = [];",
                  "      Object.keys(val).forEach(function(subKey) {",
                  "        var subVal = val[subKey];",
                  "        if (subVal !== null && subVal !== undefined) {",
                  "          subRows.push({ subKey: subKey, subVal: formatValue(subVal) });",
                  "        }",
                  "      });",
                  "      if (subRows.length > 0) {",
                  "        rows.push({ key: key, isObject: true, subRows: subRows });",
                  "      }",
                  "      return;",
                  "    }",
                  "",
                  "    // Handle arrays with values",
                  "    if (Array.isArray(val)) {",
                  "      rows.push({ key: key, isObject: false, value: val.join(', ') });",
                  "      return;",
                  "    }",
                  "",
                  "    rows.push({ key: key, isObject: false, value: formatValue(val) });",
                  "  });",
                  "",
                  "  return { rows: rows };",
                  "}",
                  "",
                  "pm.visualizer.set(template, createPayload());",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
